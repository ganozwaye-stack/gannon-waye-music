# Gannon Waye Music environment template
#
# Copy this file to a local .env file only when needed.
# Never commit real keys, tokens, webhook secrets, or customer data.

# Base44 public app config
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=
BASE44_APP_URL=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Metricool
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# TikTok developer app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google / Sheets
GOOGLE_SHEET_ID=

# AI assistants
OPENAI_API_KEY=
CURSOR_API_KEY=

# Music/distribution integrations
TUNECORE_API_KEY=

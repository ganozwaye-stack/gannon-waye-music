{
  "name": "CoachingSubmissionReceipt",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "maxLength": 36
    },
    "contact_fingerprint": {
      "type": "string",
      "maxLength": 64
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "lead_id": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "submission_id",
    "contact_fingerprint"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

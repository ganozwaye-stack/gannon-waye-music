{
  "name": "JournalPurchase",
  "type": "object",
  "description": "Backend-only server-verified paid journal order. Paid preorders await release and never grant access to held PDFs.",
  "properties": {
    "buyer_user_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "catalogue_version": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "book_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_cents": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "enum": [
        "aud"
      ]
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "fulfilment_type": {
      "type": "string",
      "enum": [
        "released",
        "preorder"
      ]
    },
    "fulfilment_status": {
      "type": "string",
      "enum": [
        "paid_release_verified",
        "paid_pending_release"
      ]
    },
    "delivery_by": {
      "type": "string",
      "format": "date-time"
    },
    "edition_label": {
      "type": "string"
    },
    "terms_version": {
      "type": "string"
    }
  },
  "required": [
    "buyer_user_id",
    "stripe_session_id",
    "catalogue_version",
    "offer_id",
    "verified_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

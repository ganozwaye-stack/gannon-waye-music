+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {execFileSync} from 'node:child_process';
+import {createHash} from 'node:crypto';
+const manifest=JSON.parse(readFileSync('coaching-release-manifest.json','utf8'));
+const allowed=[...manifest.source,...manifest.assets,...manifest.tests,...manifest.support].sort();
+const changed=execFileSync('git',['diff','--name-only',manifest.baseline],{encoding:'utf8'}).trim().split('\n').filter(Boolean).sort();
+assert.deepEqual(changed,allowed,'Every changed/new tracked file must be explicitly listed');
+execFileSync('git',['diff','--exit-code',manifest.baseline,'--','base44','package.json','package-lock.json','index.html','.github','src/api','src/lib/analytics.js','src/lib/platformConfig.js','src/pages/Store.jsx','src/components/public/setfree-hero']);
+for(const path of manifest.assets){
+ assert.ok(path.endsWith('.png'));
+ const bytes=readFileSync(path);
+ assert.deepEqual([...bytes.subarray(0,8)],[137,80,78,71,13,10,26,10]);
+ assert.equal(createHash('sha256').update(bytes).digest('hex'),manifest.assetSha256[path]);
+}
+const {PUBLIC_JOURNALS,JOURNAL_PURCHASES_ENABLED}=await import('../src/lib/publicJournalCatalogue.js');
+assert.equal(PUBLIC_JOURNALS.length,6);assert.equal(JOURNAL_PURCHASES_ENABLED,false);assert.ok(PUBLIC_JOURNALS.every(book=>book.releaseApproved===false));
+const panel=readFileSync('src/components/coaching/JournalPurchasePanel.jsx','utf8');
+assert.ok(!panel.includes('functions.')&&!panel.includes('@/api/'));
+assert.ok(readFileSync('src/components/coaching/CoachingIntakeForm.jsx','utf8').includes('const registrationOpen=false;'));
+const {DOUBLE_OPT_IN_ENABLED}=await import('../src/config/emailSignup.js');assert.equal(DOUBLE_OPT_IN_ENABLED,false);
+const {consultationEmailHref}=await import('../src/lib/coachingOffer.js');
+assert.equal(consultationEmailHref('owner@example.invalid?injected=yes'),null);
+assert.equal(consultationEmailHref('owner@example.invalid\r\nBcc: other@example.invalid'),null);
+const email=decodeURIComponent(consultationEmailHref('owner@example.invalid'));
+assert.ok(email.includes('A$99, 45-minute paid initial consultation'));
+assert.ok(!/date.of.birth|diagnos|medical/.test(email));
+console.log('PASS: exact declared patch scope; baseline hero/store/backend/API/analytics/flags/dependencies/workflows unchanged; original PNG hashes preserved; no book payment/download callbacks; registration/signup/release holds; email composer injection rejected.');

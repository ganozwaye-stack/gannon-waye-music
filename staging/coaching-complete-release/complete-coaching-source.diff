+/* Static metallic light catches: no flashing, sweeps or animated sparkle. */
+.coaching-journal-rim {
+  position: absolute;
+  border: 3px solid transparent;
+  box-sizing: content-box;
+  background: linear-gradient(#141419, #141419) padding-box,
+    linear-gradient(135deg, #98702c 0%, #f4d98d 12%, #fff8da 17%, #ba8735 25%, #e7c46a 44%, #fff6cd 51%, #a87825 60%, #edce7c 80%, #fff4c9 86%, #916b2d 100%) border-box;
+  box-shadow: 1px 0 0 #f9df95, 4px 5px 0 #755622, 8px 18px 22px rgba(0,0,0,.65), 0 0 10px rgba(229,190,90,.09);
+}
+.coaching-journal-rim img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+}
+.coaching-edge-glint {
+  position: absolute;
+  top: -8px;
+  left: 16px;
+  width: 14px;
+  height: 14px;
+  pointer-events: none;
+}
+.coaching-edge-glint::before,
+.coaching-edge-glint::after {
+  content: '';
+  position: absolute;
+  background: linear-gradient(transparent, rgba(255,250,219,.95), transparent);
+  filter: drop-shadow(0 0 3px rgba(255,223,140,.45));
+}
+.coaching-edge-glint::before { left: 6px; width: 2px; height: 14px; }
+.coaching-edge-glint::after { top: 6px; width: 14px; height: 2px; transform: rotate(0deg); background: linear-gradient(90deg, transparent, rgba(255,250,219,.95), transparent); }
+.coaching-display-base {
+  position: absolute;
+  left: 55px;
+  top: 553px;
+  width: 970px;
+  height: 75px;
+  pointer-events: none;
+  border-radius: 50%;
+  background: radial-gradient(ellipse, rgba(211,168,68,.12), transparent 65%);
+  box-shadow: 0 20px 25px rgba(0,0,0,.48);
+}
+.coaching-display-base::before {
+  content: '';
+  position: absolute;
+  inset: 24px 0 0;
+  border-radius: 0 0 50% 50%;
+  background: linear-gradient(180deg, #29241d, #141419 58%, #090b0f);
+  border-bottom: 2px solid rgba(180,141,55,.45);
+}
+.coaching-display-base::after {
+  content: '';
+  position: absolute;
+  inset: 0 0 21px;
+  border-radius: 50%;
+  background: radial-gradient(ellipse at 50% 32%, #373125, #1d1c1c 55%, #101218);
+  border: 2px solid rgba(231,201,122,.65);
+  box-shadow: inset 0 2px 0 rgba(255,237,187,.22), 0 1px 8px rgba(233,191,92,.08);
+}
+/* Explicitly preserve a motionless display when reduced motion is requested. */
+@media (prefers-reduced-motion: reduce) {
+  .coaching-journal-rim, .coaching-edge-glint, .coaching-display-base,
+  .coaching-edge-glint::before, .coaching-edge-glint::after,
+  .coaching-display-base::before, .coaching-display-base::after {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+/* Symmetric newspaper exclusion; DOM order stays paragraphs 1–3, fan, 4–7. */
+.coaching-newspaper { position: relative; max-width: 64rem; margin: 0 auto; }
+.coaching-story-column { display: flow-root; min-width: 0; }
+.coaching-story-exclusion { display: none; }
+@media (min-width: 1024px) {
+  .coaching-newspaper { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 32px; }
+  .coaching-story-left { grid-column: 1; grid-row: 1; }
+  .coaching-story-right { grid-column: 2; grid-row: 1; }
+  .coaching-newspaper .coaching-central-fan { position: absolute; left: 50%; top: 240px; width: 480px; max-width: 48%; margin: 0; transform: translateX(-50%); z-index: 1; }
+  .coaching-story-exclusion { display: block; width: min(240px, 50%); height: 600px; pointer-events: none; shape-margin: 10px; }
+  .coaching-story-exclusion-left { float: right; shape-outside: polygon(6.741% 51.290%, 59.755% 42.289%, 100.000% 42.289%, 100.000% 86.519%, 90.612% 86.503%, 81.326% 86.458%, 72.246% 86.383%, 63.469% 86.278%, 55.093% 86.146%, 47.208% 85.988%, 39.902% 85.805%, 33.255% 85.599%, 27.338% 85.373%, 22.218% 85.130%, 17.950% 84.871%, 14.581% 84.599%, 12.148% 84.318%, 10.677% 84.031%, 10.185% 83.741%); }
+  .coaching-story-exclusion-right { float: left; shape-outside: polygon(93.259% 51.290%, 40.245% 42.289%, 0.000% 42.289%, 0.000% 86.519%, 9.388% 86.503%, 18.674% 86.458%, 27.754% 86.383%, 36.531% 86.278%, 44.907% 86.146%, 52.792% 85.988%, 60.098% 85.805%, 66.745% 85.599%, 72.662% 85.373%, 77.782% 85.130%, 82.050% 84.871%, 85.419% 84.599%, 87.852% 84.318%, 89.323% 84.031%, 89.815% 83.741%); }
+}
+
+/* The symmetric contours follow the rotated original cover hull and display ellipse. */
+
+/* Membership sits below both article columns, aligned with their left edge. */
+.coaching-membership-footer { grid-column: 1; grid-row: 2; justify-self: start; }

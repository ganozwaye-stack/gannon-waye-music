{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@tanstack/react-query": ["./src/types/react-query-shim.d.ts"],
      "@/components/ui/*": ["./src/types/ui-component-shims.d.ts"],
      "@/*": ["./src/*"],
      "react-router-dom": ["./src/lib/react-router-dom.d.ts"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/components/**/*.js", "src/pages/**/*.jsx", "src/Layout.jsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "src/vite-plugins", "src/components/ui", "src/api", "src/lib"]
}

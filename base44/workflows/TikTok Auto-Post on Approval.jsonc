{
  "name": "TikTok Auto-Post on Approval",
  "description": "Paused by the global safety hold. No TikTok upload or draft creation is permitted from approval events.",
  "trigger": {
    "condition": "${ false }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ContentStudioRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tiktok_auto_post_on_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postApprovedToTiktok",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "postApprovedToTiktok"
  }
}
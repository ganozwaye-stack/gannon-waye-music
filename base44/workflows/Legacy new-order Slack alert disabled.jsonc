{
  "name": "Legacy new-order Slack alert disabled",
  "description": "Disabled so one canonical automation owns each paid-order alert",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "MerchOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "legacy_new_order_slack_alert_disabled",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onNewOrderSlack",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onNewOrderSlack"
  }
}
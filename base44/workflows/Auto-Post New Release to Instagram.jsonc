{
  "name": "Auto-Post New Release to Instagram",
  "description": "Disabled safety hold. Create and approve a channel-specific Instagram draft before any post is made.",
  "trigger": {
    "condition": "${ false }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Release"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_post_new_release_to_instagram",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postReleaseToSocial",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "postReleaseToSocial"
  }
}
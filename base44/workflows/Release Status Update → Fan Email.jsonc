{
  "name": "Release Status Update \u2192 Fan Email",
  "description": "Paused by the global safety hold. After a controlled owner test, this may prepare an internal owner-reviewed draft only; it never sends an email.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Release",
      "events": [
        "update"
      ]
    },
    "condition": "${ false }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "release_status_email_draft",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare_fan_email_draft": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "prepareReleaseEmailDraft",
            "args": {
              "release_id": "${ .trigger.entity_id }",
              "new_status": "${ .trigger.data.status }",
              "source": "status_change"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Prepare the fan email draft",
            "description": "Draft lands in the email studio for approval"
          }
        }
      }
    ]
  }
}
{
  "name": "Deego Heartbeat  -  Every 30 Minutes",
  "description": "Deego heartbeat every 30 minutes. Updates approval budget, $1M profit target, current blockers, and task log. Internal only: no spend, no publishing, no supplier contact, no external messages.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-17T11:50:27.466000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deego_heartbeat_every_30_minutes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agentIntelligenceLoop",
            "args": {
              "mode": "deego_heartbeat"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "agentIntelligenceLoop"
  }
}
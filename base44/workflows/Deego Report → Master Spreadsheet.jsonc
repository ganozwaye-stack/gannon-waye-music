{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deego_report_to_master_spreadsheet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDeegoReportsToSheets",
            "args": {
              "report_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync report to master spreadsheet",
            "description": "Report, offers and market comparison"
          }
        }
      }
    ]
  },
  "description": "Automatically pushes every new or updated Deego owner report into the master Google Spreadsheet, keeping the report, offers and market comparison tabs in sync.",
  "name": "Deego Report \u2192 Master Spreadsheet",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "DeegoOwnerReport"
    }
  }
}
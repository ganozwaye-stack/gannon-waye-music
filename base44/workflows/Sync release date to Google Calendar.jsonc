{
  "name": "Sync release date to Google Calendar",
  "description": "When a Release's release_date is updated in the admin console, sync the release schedule to Gannon's Google Calendar (creates or updates the matching event).",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"release_date\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Release"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_release_date_to_google_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "releaseCalendarSync",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "releaseCalendarSync"
  }
}
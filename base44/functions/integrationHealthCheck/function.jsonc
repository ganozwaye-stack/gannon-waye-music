{
  "name": "integrationHealthCheck",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "description": "Daily check: Stripe live mode, Toolost API, Slack alerts, webhook secret",
      "ends_type": "never",
      "is_active": true,
      "name": "Integration Health Check (Daily 8am)",
      "repeat_interval": 1,
      "repeat_unit": "days",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "start_time": "08:00"
    }
  ]
}
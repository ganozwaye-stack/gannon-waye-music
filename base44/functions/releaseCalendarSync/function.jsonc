{
  "name": "releaseCalendarSync",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "description": "Syncs all Release entities to Google Calendar every Monday morning.",
      "ends_type": "never",
      "is_active": true,
      "name": "Weekly Release Calendar Sync",
      "repeat_on_days": [
        1
      ],
      "repeat_unit": "weeks",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "start_time": "09:00"
    }
  ]
}
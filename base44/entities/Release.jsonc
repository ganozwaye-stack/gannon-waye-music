{
  "name": "Release",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song or album title"
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album"
      ],
      "default": "single"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "writing",
        "pre_production",
        "recording",
        "mixing",
        "mastering",
        "ready",
        "released"
      ],
      "default": "idea"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "artwork_url": {
      "type": "string",
      "description": "Cover artwork image URL"
    },
    "description": {
      "type": "string"
    },
    "lyrics": {
      "type": "string",
      "description": "Full lyrics text \u2014 no character limit"
    },
    "lyrics_status": {
      "type": "string",
      "enum": [
        "missing",
        "coming_soon",
        "published"
      ],
      "default": "missing"
    },
    "credits": {
      "type": "string",
      "description": "Production credits"
    },
    "distributor": {
      "type": "string",
      "description": "Distribution partner name"
    },
    "distributor_link": {
      "type": "string",
      "description": "Link to distributor portal"
    },
    "spotify_link": {
      "type": "string"
    },
    "apple_music_link": {
      "type": "string"
    },
    "youtube_link": {
      "type": "string",
      "description": "YouTube music video URL"
    },
    "youtube_video_id": {
      "type": "string",
      "description": "YouTube video ID for embed (e.g. dQw4w9WgXcQ)"
    },
    "is_current_single": {
      "type": "boolean",
      "default": false,
      "description": "If true, shown on the current single feature page",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "current_single_hero_copy": {
      "type": "string",
      "description": "Emotional intro copy for current single page"
    },
    "current_single_behind_story": {
      "type": "string",
      "description": "Behind the song story for current single page"
    },
    "other_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "price": {
      "type": "number",
      "description": "Digital purchase price"
    },
    "duration": {
      "type": "string",
      "description": "Track duration in mm:ss format"
    },
    "language": {
      "type": "string",
      "default": "English",
      "description": "Primary language of this release"
    },
    "version_label": {
      "type": "string",
      "description": "Version label such as Original, Radio Edit, or Brazilian Portuguese"
    },
    "genre": {
      "type": "string",
      "enum": [
        "singer_songwriter",
        "folk",
        "soul",
        "pop",
        "rnb",
        "hip_hop",
        "spoken_word",
        "cinematic",
        "rock",
        "other"
      ],
      "description": "Primary genre/style for fan browsing. Owner-tagged; untagged releases remain visible under All."
    },
    "mood": {
      "type": "string",
      "enum": [
        "reflective",
        "tender",
        "raw",
        "uplifting",
        "melancholic",
        "hopeful",
        "anthemic",
        "intimate",
        "other"
      ],
      "description": "Emotional mood for fan browsing. Owner-tagged; untagged releases remain visible under All."
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "publishing_safe": {
      "type": "boolean",
      "default": false,
      "description": "Owner-controlled prerequisite for any public Release visibility.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "public_release_approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "revoked"
      ],
      "default": "pending",
      "description": "Exact owner approval state. Approval and public publication are separate actions.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "public_release_approved_by": {
      "type": "string",
      "description": "Exact owner email that approved this title and version.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        },
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "public_release_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of exact owner approval.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        },
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "public_release_approval_note": {
      "type": "string",
      "maxLength": 1000,
      "description": "Private audit note for approval or revocation.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        },
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "auto_publish_on_release_date": {
      "type": "boolean",
      "default": false,
      "description": "Set at New Release Studio submission: publish this release publicly at midnight on its release date, executing the owner's one-button approval. Legacy releases stay false and keep the manual publish flow.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.is_published": true
            },
            {
              "data.publishing_safe": true
            },
            {
              "data.status": "released"
            },
            {
              "data.public_release_approval_status": "approved"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "ganozwaye@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "gannonwayemusic@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "ganozwaye@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "gannonwayemusic@gmail.com"
          }
        }
      ]
    }
  }
}
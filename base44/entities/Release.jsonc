{
  "name": "Release",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song or album title"
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album"
      ],
      "default": "single"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "writing",
        "pre_production",
        "recording",
        "mixing",
        "mastering",
        "ready",
        "released"
      ],
      "default": "idea"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "artwork_url": {
      "type": "string",
      "description": "Cover artwork image URL"
    },
    "description": {
      "type": "string"
    },
    "lyrics": {
      "type": "string",
      "description": "Full lyrics text \u2014 no character limit"
    },
    "lyrics_status": {
      "type": "string",
      "enum": [
        "missing",
        "coming_soon",
        "published"
      ],
      "default": "missing"
    },
    "credits": {
      "type": "string",
      "description": "Production credits"
    },
    "distributor": {
      "type": "string",
      "description": "Distribution partner name"
    },
    "distributor_link": {
      "type": "string",
      "description": "Link to distributor portal"
    },
    "spotify_link": {
      "type": "string"
    },
    "apple_music_link": {
      "type": "string"
    },
    "youtube_link": {
      "type": "string",
      "description": "YouTube music video URL"
    },
    "youtube_video_id": {
      "type": "string",
      "description": "YouTube video ID for embed (e.g. dQw4w9WgXcQ)"
    },
    "is_current_single": {
      "type": "boolean",
      "default": false,
      "description": "If true, shown on the current single feature page"
    },
    "current_single_hero_copy": {
      "type": "string",
      "description": "Emotional intro copy for current single page"
    },
    "current_single_behind_story": {
      "type": "string",
      "description": "Behind the song story for current single page"
    },
    "other_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "price": {
      "type": "number",
      "description": "Digital purchase price"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
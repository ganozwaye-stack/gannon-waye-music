{
  "name": "MerchOrder",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "recorded_unit_cost": {
            "type": "number"
          },
          "recorded_packaging_cost": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "subtotal_amount": {
      "type": "number"
    },
    "shipping_amount": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "support_contribution": {
      "type": "number",
      "default": 0
    },
    "gst_amount": {
      "type": "number",
      "default": 0
    },
    "abn": {
      "type": "string"
    },
    "shipping_rule_id": {
      "type": "string"
    },
    "shipping_rule_name": {
      "type": "string"
    },
    "checkout_policy": {
      "type": "string"
    },
    "order_source": {
      "type": "string"
    },
    "stripe_event_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "failed",
        "refunded",
        "partially_refunded",
        "disputed"
      ],
      "default": "unpaid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled",
        "needs_admin_review",
        "duplicate"
      ],
      "default": "pending"
    },
    "financial_status": {
      "type": "string"
    },
    "fulfillment_status": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "inventory_adjusted": {
      "type": "boolean",
      "default": false
    },
    "inventory_adjusted_at": {
      "type": "string",
      "format": "date-time"
    },
    "inventory_adjustment_details": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "product_cost_total": {
      "type": "number"
    },
    "packaging_cost_total": {
      "type": "number"
    },
    "estimated_delivery_cost": {
      "type": "number"
    },
    "actual_delivery_cost": {
      "type": "number"
    },
    "estimated_payment_fee": {
      "type": "number"
    },
    "payment_fee_amount": {
      "type": "number"
    },
    "estimated_net_order_profit": {
      "type": "number"
    },
    "net_order_profit": {
      "type": "number"
    },
    "profit_status": {
      "type": "string",
      "enum": [
        "pending_costs",
        "estimated",
        "final"
      ],
      "default": "pending_costs"
    },
    "profit_calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_sent": {
      "type": "boolean",
      "default": false
    },
    "receipt_status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "sent",
        "failed",
        "not_required"
      ],
      "default": "not_attempted"
    },
    "admin_notification_sent": {
      "type": "boolean",
      "default": false
    },
    "admin_notification_status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "created",
        "failed"
      ],
      "default": "not_attempted"
    },
    "ledger_sync_status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "synced",
        "failed"
      ],
      "default": "not_attempted"
    },
    "duplicate_of_order_id": {
      "type": "string"
    },
    "excluded_from_revenue": {
      "type": "boolean",
      "default": false
    },
    "excluded_from_inventory": {
      "type": "boolean",
      "default": false
    },
    "excluded_from_profit": {
      "type": "boolean",
      "default": false
    },
    "excluded_from_1800respect_donation": {
      "type": "boolean",
      "default": true
    },
    "admin_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
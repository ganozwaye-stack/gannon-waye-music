{
  "name": "GalleryImage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Image URL \u2014 use UploadFile to get a URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "professional_photo",
        "tour_snapshot",
        "release_artwork",
        "behind_scenes",
        "press",
        "personal"
      ],
      "default": "professional_photo"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "image_date": {
      "type": "string",
      "format": "date",
      "description": "When the photo was taken or artwork created"
    },
    "photographer_credit": {
      "type": "string"
    },
    "related_release": {
      "type": "string",
      "description": "Linked release if artwork"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
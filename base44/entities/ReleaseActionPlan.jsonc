{
  "name": "ReleaseActionPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "needs_approval",
        "scheduled",
        "complete",
        "deferred"
      ],
      "default": "not_started"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "related_page": {
      "type": "string"
    },
    "related_song": {
      "type": "string"
    },
    "related_release": {
      "type": "string"
    },
    "related_product": {
      "type": "string"
    },
    "related_link": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "blocker_reason": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "approval_notes": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "release_name": {
      "type": "string"
    },
    "step_type": {
      "type": "string",
      "enum": [
        "song_record",
        "artwork",
        "lyrics_storage",
        "lyrics_approval",
        "story",
        "release_page",
        "spotify_link",
        "apple_music_link",
        "youtube_link",
        "press_pitch",
        "playlist_pitch",
        "reel_hooks",
        "merch_tie_in",
        "newsletter_draft",
        "manychat_keyword",
        "metricool_draft",
        "approval_status",
        "publish_status"
      ],
      "default": "song_record"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "TooLostConnection",
  "type": "object",
  "properties": {
    "token_envelope": {
      "type": "string",
      "description": "AES-GCM encrypted server-only Too Lost access and refresh tokens"
    },
    "access_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current access token expires"
    },
    "scope": {
      "type": "string",
      "description": "Scopes granted by Too Lost"
    },
    "connected_name": {
      "type": "string",
      "description": "Display name of the connected Too Lost account"
    },
    "connected_email": {
      "type": "string",
      "description": "Email of the connected Too Lost account"
    },
    "last_refreshed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the tokens were last exchanged or renewed"
    },
    "pending_oauth_state_hash": {
      "type": "string",
      "description": "Short-lived server-only hash used to validate an OAuth callback"
    },
    "pending_oauth_state_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry for the pending OAuth security check"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "email": "__service_role_only__@invalid.local"
      }
    },
    "read": {
      "user_condition": {
        "email": "__service_role_only__@invalid.local"
      }
    },
    "update": {
      "user_condition": {
        "email": "__service_role_only__@invalid.local"
      }
    },
    "delete": {
      "user_condition": {
        "email": "__service_role_only__@invalid.local"
      }
    }
  }
}
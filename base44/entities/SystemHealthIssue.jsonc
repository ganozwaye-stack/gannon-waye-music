{
  "name": "SystemHealthIssue",
  "type": "object",
  "properties": {
    "system_area": {
      "type": "string",
      "enum": [
        "routing",
        "data",
        "automations",
        "agent_registry",
        "integrations",
        "approvals",
        "risk_alerts",
        "payments",
        "email",
        "security",
        "other"
      ],
      "default": "other"
    },
    "issue_title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ],
      "default": "warning"
    },
    "detected_by": {
      "type": "string"
    },
    "recommended_fix": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "drafting_fix",
        "needs_approval",
        "approved",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "requires_approval": {
      "type": "boolean",
      "default": false
    },
    "risk_type": {
      "type": "string",
      "enum": [
        "none",
        "financial",
        "legal",
        "reputation",
        "data",
        "payment",
        "public_content"
      ],
      "default": "none"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "issue_title",
    "severity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "MerchProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "apparel",
        "accessories",
        "vinyl",
        "cd",
        "poster",
        "bundle",
        "other"
      ],
      "default": "apparel"
    },
    "sale_price": {
      "type": "number",
      "description": "Retail price charged to customer"
    },
    "cost_price": {
      "type": "number",
      "description": "Recorded product acquisition cost per unit. The verification status is held separately."
    },
    "delivery_cost": {
      "type": "number",
      "description": "Recorded expected delivery cost per unit for internal margin estimates. Customer shipping is calculated separately at checkout."
    },
    "packaging_cost": {
      "type": "number",
      "default": 0,
      "description": "Recorded packaging cost per unit where known."
    },
    "merchant_fee_percent": {
      "type": "number",
      "default": 3.5,
      "description": "Payment processor fee percentage used for internal estimates."
    },
    "image_url": {
      "type": "string"
    },
    "images_array": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multiple product images"
    },
    "sizes_available": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "stock_by_variant": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Owned stock by size or other variant. Variant stock is authoritative when present."
    },
    "inventory_source": {
      "type": "string",
      "enum": [
        "owned_stock",
        "print_on_demand",
        "dropship",
        "digital",
        "other"
      ],
      "default": "owned_stock"
    },
    "stock_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "stock_verification_note": {
      "type": "string",
      "maxLength": 2000
    },
    "cost_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "cost_verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "owner_approved_recorded_cost",
        "invoice_verified"
      ],
      "default": "unverified"
    },
    "cost_verification_note": {
      "type": "string",
      "maxLength": 2000
    },
    "supplier_url": {
      "type": "string",
      "description": "Required only for supplier-driven or print-on-demand inventory."
    },
    "shipping_policy": {
      "type": "string",
      "enum": [
        "customer_pays",
        "included",
        "local_pickup_only",
        "quote_required"
      ],
      "default": "customer_pays"
    },
    "exclude_from_discounts": {
      "type": "boolean",
      "default": false
    },
    "is_stage_one_sale": {
      "type": "boolean",
      "default": false
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "approved",
        "live",
        "retired"
      ],
      "default": "draft",
      "description": "Public lifecycle. Only live records may render on gannonwaye.com"
    },
    "approved_by": {
      "type": "string",
      "description": "Base44 human user ID that approved this exact product"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "profit_margin_percent": {
      "type": "number",
      "description": "Legacy estimate only. Actual order profit must be calculated from completed order costs."
    },
    "total_profit_per_unit": {
      "type": "number",
      "description": "Legacy estimate only. Actual order profit must be calculated from completed order costs."
    }
  },
  "required": [
    "name",
    "sale_price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.is_active": true
            },
            {
              "data.publication_status": "live"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
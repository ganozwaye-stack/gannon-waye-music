{
  "name": "MerchInterest",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "consent_email": {
      "type": "boolean",
      "default": false
    },
    "consent_news": {
      "type": "boolean",
      "default": false
    },
    "consent_events": {
      "type": "boolean",
      "default": false
    },
    "consent_merch": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "product_id",
    "name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
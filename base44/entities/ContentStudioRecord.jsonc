{
  "name": "ContentStudioRecord",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "reel_idea",
        "hook",
        "caption",
        "first_comment",
        "lyric_quote_post",
        "manychat_keyword",
        "music_link",
        "merch_link",
        "press_snippet",
        "pitch_angle",
        "metricool_draft",
        "approval_queue",
        "posted_archive",
        "performance_note"
      ],
      "default": "reel_idea"
    },
    "title": {
      "type": "string",
      "description": "Post title shown on the Content Studio card"
    },
    "song": {
      "type": "string",
      "description": "Song title this content relates to"
    },
    "release": {
      "type": "string",
      "description": "Release name (single/EP/album)"
    },
    "hook": {
      "type": "string",
      "maxLength": 500,
      "description": "Hook text for the reel/post"
    },
    "on_screen_text": {
      "type": "string",
      "maxLength": 1000,
      "description": "Text overlay for the video"
    },
    "caption": {
      "type": "string",
      "maxLength": 2200,
      "description": "Social media caption"
    },
    "first_comment": {
      "type": "string",
      "maxLength": 2200,
      "description": "First comment to post after the reel"
    },
    "hashtags": {
      "type": "string",
      "maxLength": 1000,
      "description": "Hashtags for the post (space or comma separated)"
    },
    "visual_direction": {
      "type": "string",
      "maxLength": 1000,
      "description": "Visual direction: lighting, shot type, text overlay style"
    },
    "capcut_template": {
      "type": "string",
      "description": "CapCut template name or link to use"
    },
    "cta": {
      "type": "string",
      "description": "Call to action text"
    },
    "manychat_keyword": {
      "type": "string",
      "description": "ManyChat trigger keyword (e.g. THANKYOU, LISTEN)"
    },
    "destination_link": {
      "type": "string",
      "description": "URL the CTA links to"
    },
    "asset_required": {
      "type": "string",
      "description": "What visual/video asset is needed"
    },
    "media_url": {
      "type": "string",
      "description": "Attached video file URL (used for thumbnail preview and publishing)"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled publish date and time. Cards are sorted by this field."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "metricool_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "draft",
        "scheduled",
        "published",
        "failed"
      ],
      "default": "not_sent"
    },
    "posted_status": {
      "type": "string",
      "enum": [
        "not_posted",
        "posted",
        "archived"
      ],
      "default": "not_posted"
    },
    "performance_notes": {
      "type": "string",
      "maxLength": 3000,
      "description": "Notes on post performance after publishing"
    },
    "platform": {
      "type": "string",
      "enum": [
        "tiktok",
        "instagram",
        "youtube",
        "facebook",
        "x_twitter",
        "all"
      ],
      "default": "instagram"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "content_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
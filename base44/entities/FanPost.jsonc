{
  "name": "FanPost",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "review",
        "photo"
      ],
      "default": "message"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status"
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Set true to block this submitter from future posts"
    },
    "blocked_reason": {
      "type": "string",
      "description": "Admin reason for block"
    },
    "ip_address": {
      "type": "string",
      "description": "Submitter IP address if available from request context, else 'unavailable'"
    },
    "ip_hash": {
      "type": "string",
      "description": "SHA-256 hash of IP for privacy-safe deduplication"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent string at time of submission"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "clean",
        "flagged",
        "blocked"
      ],
      "default": "unreviewed",
      "description": "Admin moderation flag"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "created_by": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
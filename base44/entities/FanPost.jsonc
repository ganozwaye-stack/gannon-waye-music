{
  "name": "FanPost",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "review",
        "photo"
      ],
      "default": "message"
    }
  },
  "required": [
    "content"
  ]
}
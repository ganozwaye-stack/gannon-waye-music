{
  "name": "SiteReveal",
  "type": "object",
  "properties": {
    "artwork_revealed": {
      "type": "boolean",
      "default": false,
      "description": "Legacy private artwork reveal toggle; never authorises a public Release."
    },
    "merch_revealed": {
      "type": "boolean",
      "default": false,
      "description": "Private merch visibility toggle."
    },
    "release_date_text": {
      "type": "string",
      "description": "Legacy private date text; non-authoritative."
    },
    "release_date_iso": {
      "type": "string",
      "description": "Legacy private date value; non-authoritative."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this reveal configuration"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}
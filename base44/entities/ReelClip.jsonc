{
  "name": "ReelClip",
  "type": "object",
  "properties": {
    "source_video_id": {
      "type": "string",
      "description": "Reference to the SourceVideo this clip was cut from"
    },
    "source_video_title": {
      "type": "string",
      "description": "Denormalised source video title for quick display"
    },
    "clip_video_url": {
      "type": "string",
      "description": "Opus Clip exportable clip video URL"
    },
    "opus_clip_id": {
      "type": "string",
      "description": "Opus Clip clip id"
    },
    "virality_score": {
      "type": "number",
      "description": "Opus Clip virality score, 0 to 100"
    },
    "hook": {
      "type": "string",
      "description": "Punchy opening line for the reel caption"
    },
    "caption": {
      "type": "string",
      "description": "Full caption body text"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hashtags for the post"
    },
    "first_comment": {
      "type": "string",
      "description": "First comment to spark conversation plus a survivor-support call to action"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Cover or thumbnail image for the reel (e.g. the This Is Me cover)"
    },
    "music_bed_url": {
      "type": "string",
      "description": "Music track to lay behind the clip"
    },
    "music_volume_percent": {
      "type": "number",
      "default": 2,
      "description": "Music bed volume. 2 means 2 percent"
    },
    "platform_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "instagram_reels",
          "facebook_reels",
          "youtube_shorts",
          "tiktok"
        ]
      },
      "default": [
        "instagram_reels",
        "facebook_reels",
        "youtube_shorts",
        "tiktok"
      ]
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "needs_review",
        "in_revision",
        "approved",
        "rejected"
      ],
      "default": "needs_review"
    },
    "post_status": {
      "type": "string",
      "enum": [
        "not_posted",
        "posting",
        "posted",
        "partial",
        "failed"
      ],
      "default": "not_posted"
    },
    "post_log": {
      "type": "string",
      "description": "JSON string of per-platform posting results"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "source_video_id",
    "clip_video_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
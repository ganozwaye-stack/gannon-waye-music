{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "hero_image_url": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "twitter_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "spotify_url": {
      "type": "string"
    },
    "apple_music_url": {
      "type": "string"
    },
    "email_contact": {
      "type": "string"
    },
    "show_thank_you_campaign_section": {
      "type": "boolean",
      "default": true,
      "description": "Controls visibility of the Thank You campaign artwork section on the homepage."
    },
    "live_stream_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable the public /live page"
    },
    "live_stream_status": {
      "type": "string",
      "enum": [
        "offline",
        "scheduled",
        "live",
        "ended"
      ],
      "default": "offline"
    },
    "live_stream_provider": {
      "type": "string",
      "description": "e.g. YouTube, Vimeo, StreamYard"
    },
    "live_stream_title": {
      "type": "string"
    },
    "live_stream_scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_stream_embed_url": {
      "type": "string",
      "description": "Public HTTPS embed URL only \u2014 no stream keys or private dashboard URLs"
    },
    "live_stream_chat_url": {
      "type": "string",
      "description": "Optional public chat embed URL"
    },
    "live_stream_tiktok_url": {
      "type": "string",
      "description": "Optional direct link to TikTok Live (e.g. https://www.tiktok.com/@gann0nwaye/live)"
    },
    "live_stream_instagram_url": {
      "type": "string",
      "description": "Optional direct link to Instagram Live (e.g. https://www.instagram.com/gann0nwaye/live)"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
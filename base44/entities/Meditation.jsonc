{
  "name": "Meditation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "meditation_type": {
      "type": "string",
      "enum": [
        "breathwork",
        "body_scan",
        "visualisation",
        "reflection",
        "affirmation",
        "guided"
      ],
      "default": "guided"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "program": {
      "type": "string",
      "description": "Which coaching program this meditation belongs to (or All Programs)"
    },
    "audio_url": {
      "type": "string",
      "description": "Audio file URL for playback \u2014 use UploadFile to get a URL"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "What this meditation guides the listener through"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Private notes about this meditation"
    }
  },
  "required": [
    "title",
    "meditation_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
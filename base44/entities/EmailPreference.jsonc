{
  "name": "EmailPreference",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "consent_new_music": {
      "type": "boolean",
      "default": false
    },
    "consent_behind_scenes": {
      "type": "boolean",
      "default": false
    },
    "consent_tour_events": {
      "type": "boolean",
      "default": false
    },
    "consent_merch_drops": {
      "type": "boolean",
      "default": false
    },
    "consent_exclusive_content": {
      "type": "boolean",
      "default": false
    },
    "consent_personal_stories": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this fan's preferences"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "data.email": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
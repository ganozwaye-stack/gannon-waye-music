{
  "name": "FanComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of parent post/release/page"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "fan_post",
        "release",
        "current_single",
        "music_video",
        "community"
      ],
      "default": "fan_post"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "For replies"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "flagged"
      ],
      "default": "pending"
    },
    "love_count": {
      "type": "number",
      "default": 0
    },
    "loved_by_gannon": {
      "type": "boolean",
      "default": false
    },
    "love_email_sent": {
      "type": "boolean",
      "default": false
    },
    "admin_reply": {
      "type": "string"
    },
    "consent_email": {
      "type": "boolean",
      "default": false
    },
    "is_flagged": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "post_type",
    "author_name",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "FanPlaylist",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "spotify_embed_url": {
      "type": "string",
      "description": "Spotify playlist embed URL (https://open.spotify.com/embed/playlist/ID)"
    },
    "cover_image_url": {
      "type": "string"
    },
    "curator_note": {
      "type": "string",
      "maxLength": 500,
      "description": "Personal note from Gannon about why he curated this playlist"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "spotify_embed_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "StorefrontHotspot",
  "type": "object",
  "description": "A clickable zone placed over the LOCKED boutique hero photo (src/config/storefrontArtLock.js), linking one region of that permanent image to one live MerchProduct. Never stores or references any other image \u2014 these zones only ever sit on top of the one locked artwork.",
  "properties": {
    "lock_id": {
      "type": "string",
      "default": "gannon-waye-boutique-world-v1",
      "description": "Must match STOREFRONT_ART_LOCK.lockId. Exists so a hotspot can never silently get reinterpreted as belonging to a different, unlocked image."
    },
    "zone_key": {
      "type": "string",
      "description": "Short internal label for this zone, e.g. 'hoodie-left-rack', 'display-case-mug'."
    },
    "product_id": {
      "type": "string",
      "description": "MerchProduct id this zone opens when clicked."
    },
    "left_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Left edge of the zone as a % of the image width."
    },
    "top_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Top edge of the zone as a % of the image height."
    },
    "width_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Zone width as a % of the image width."
    },
    "height_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Zone height as a % of the image height."
    },
    "label_override": {
      "type": "string",
      "description": "Optional custom hover label. Falls back to the linked product's name + price when blank."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive zones are kept for reference but never rendered on the public store."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "zone_key",
    "product_id",
    "left_pct",
    "top_pct",
    "width_pct",
    "height_pct"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
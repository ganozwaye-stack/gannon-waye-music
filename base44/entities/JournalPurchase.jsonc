{
  "name": "JournalPurchase",
  "type": "object",
  "description": "Backend-only server-verified paid journal order. Paid preorders await release and never grant access to held PDFs.",
  "properties": {
    "buyer_user_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "catalogue_version": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "book_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_cents": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "enum": [
        "aud"
      ]
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "fulfilment_type": {
      "type": "string",
      "enum": [
        "released",
        "preorder",
        "mixed"
      ]
    },
    "fulfilment_status": {
      "type": "string",
      "enum": [
        "paid_release_verified",
        "paid_pending_release",
        "paid_partial_release"
      ]
    },
    "delivery_by": {
      "type": "string",
      "format": "date-time"
    },
    "edition_label": {
      "type": "string"
    },
    "terms_version": {
      "type": "string"
    },
    "cancellation_text": {
      "type": "string"
    },
    "delay_text": {
      "type": "string"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "email_accepted",
        "review_required"
      ]
    },
    "delivery_attempt_id": {
      "type": "string"
    },
    "email_accepted_at": {
      "type": "string"
    },
    "delivery_terms_version": {
      "type": "string"
    },
    "asset_hashes": {
      "type": "object"
    },
    "buyer_details_id": {
      "type": "string"
    },
    "terms_accepted_at": {
      "type": "string"
    },
    "item_plan": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preorder_terms_snapshot": {
      "type": "object"
    },
    "release_delivery_revision": {
      "type": "integer",
      "default": 0
    },
    "release_delivery": {
      "type": "object"
    }
  },
  "required": [
    "buyer_user_id",
    "stripe_session_id",
    "catalogue_version",
    "offer_id",
    "verified_at",
    "book_ids",
    "total_cents",
    "currency",
    "stripe_payment_intent_id",
    "fulfilment_type",
    "fulfilment_status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
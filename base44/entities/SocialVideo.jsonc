{
  "name": "SocialVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title or caption for the video"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "tiktok"
      ],
      "default": "instagram"
    },
    "url": {
      "type": "string",
      "description": "Full URL to the Instagram Reel or TikTok video"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Optional thumbnail image URL"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Show on home page preview"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "url",
    "platform"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "BusinessPhoneNumber",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "phone_number": {
      "type": "string",
      "description": "The actual number \u2014 leave blank until provider selected"
    },
    "purpose": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "not_selected",
        "openphone",
        "twilio",
        "telnyx",
        "quo"
      ],
      "default": "not_selected"
    },
    "status": {
      "type": "string",
      "enum": [
        "provider_needed",
        "pending_setup",
        "active",
        "suspended"
      ],
      "default": "provider_needed"
    },
    "public_visibility": {
      "type": "string",
      "enum": [
        "hidden",
        "visible"
      ],
      "default": "hidden"
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "forwarding_destination": {
      "type": "string"
    },
    "business_hours": {
      "type": "string"
    },
    "voicemail_script": {
      "type": "string",
      "maxLength": 2000
    },
    "auto_reply_draft": {
      "type": "string",
      "maxLength": 1000
    },
    "lead_source_tracking": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "display_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
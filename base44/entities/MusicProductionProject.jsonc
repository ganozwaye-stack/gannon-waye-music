{
  "name": "MusicProductionProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track or project name"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "demo",
        "arranging",
        "recording",
        "mixing",
        "mastering",
        "ready",
        "released"
      ],
      "default": "idea"
    },
    "daw_name": {
      "type": "string",
      "description": "DAW used (e.g. Ableton, Logic Pro, FL Studio)"
    },
    "bpm": {
      "type": "number",
      "description": "Beats per minute"
    },
    "musical_key": {
      "type": "string",
      "description": "Musical key (e.g. C minor, A major)"
    },
    "time_signature": {
      "type": "string",
      "description": "Time signature (e.g. 4/4, 3/4, 6/8)",
      "default": "4/4"
    },
    "sample_rate": {
      "type": "string",
      "description": "Sample rate (e.g. 44100, 48000, 96000)"
    },
    "bit_depth": {
      "type": "string",
      "description": "Bit depth (e.g. 16, 24, 32)"
    },
    "plugin_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "description": "Chain position (e.g. EQ, Compressor, Reverb, Limiter)"
          },
          "plugin_name": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Ordered plugin chain for the project"
    },
    "related_release": {
      "type": "string",
      "description": "Linked release title if this project became a release"
    },
    "project_file_url": {
      "type": "string",
      "description": "Link to DAW project file or bounce"
    },
    "reference_track_url": {
      "type": "string",
      "description": "Reference track for sonic direction"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000,
      "description": "Production notes, ideas, to-dos"
    },
    "next_action": {
      "type": "string",
      "description": "What needs to happen next on this track"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
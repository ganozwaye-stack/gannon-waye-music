{
  "name": "ContentProductionJob",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Job title - what is being produced"
    },
    "description": {
      "type": "string",
      "maxLength": 3000,
      "description": "Brief description of the production job"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "heygen_video",
        "social_reel",
        "content_post",
        "newsletter",
        "image_generation",
        "audio_generation",
        "other"
      ],
      "default": "heygen_video"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "queued"
    },
    "script": {
      "type": "string",
      "maxLength": 10000,
      "description": "The script or text content for the production"
    },
    "video_url": {
      "type": "string",
      "description": "Completed video download URL"
    },
    "video_share_url": {
      "type": "string",
      "description": "Shareable video URL from provider"
    },
    "heygen_video_id": {
      "type": "string"
    },
    "heygen_avatar_id": {
      "type": "string"
    },
    "heygen_voice_id": {
      "type": "string"
    },
    "heygen_engine": {
      "type": "string",
      "enum": [
        "avatar_iv",
        "avatar_v",
        "avatar_iii"
      ],
      "default": "avatar_iv"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "720p",
        "1080p",
        "4k"
      ],
      "default": "1080p"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "auto",
        "16:9",
        "9:16",
        "4:5",
        "5:4",
        "1:1"
      ],
      "default": "9:16"
    },
    "related_release": {
      "type": "string"
    },
    "related_content_item_id": {
      "type": "string"
    },
    "research_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_generated_by": {
      "type": "string"
    },
    "agent_generated": {
      "type": "boolean",
      "default": false
    },
    "error_message": {
      "type": "string"
    },
    "callback_id": {
      "type": "string"
    },
    "platform_target": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "rejected",
        "published"
      ],
      "default": "needs_review"
    },
    "quarantined": {
      "type": "boolean",
      "default": false
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantine_reason": {
      "type": "string",
      "maxLength": 3000
    },
    "blocked_from_production": {
      "type": "boolean",
      "default": false
    },
    "identity_verified": {
      "type": "boolean",
      "default": false
    },
    "source_asset_authorised": {
      "type": "boolean",
      "default": false
    },
    "source_asset_owner": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "job_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
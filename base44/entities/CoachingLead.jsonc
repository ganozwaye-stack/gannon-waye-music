{
  "name": "CoachingLead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "maxLength": 2000
    },
    "current_challenge": {
      "type": "string",
      "maxLength": 2000
    },
    "support_wanted": {
      "type": "string",
      "maxLength": 1000
    },
    "understands_coaching_not_therapy": {
      "type": "boolean",
      "default": false
    },
    "consent_to_contact": {
      "type": "boolean",
      "default": false
    },
    "source_page": {
      "type": "string"
    },
    "source_offer": {
      "type": "string"
    },
    "workbook_requested": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "booked",
        "declined",
        "unresponsive",
        "archived"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "assigned_to": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "maxLength": 80
    },
    "last_name": {
      "type": "string",
      "maxLength": 80
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "submission_id": {
      "type": "string",
      "maxLength": 36
    },
    "contact_fingerprint": {
      "type": "string",
      "maxLength": 64
    },
    "duplicate_submission": {
      "type": "boolean",
      "default": false
    },
    "analytics_excluded": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      ]
    }
  }
}
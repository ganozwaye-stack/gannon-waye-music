{
  "name": "MerchVisualAsset",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "hoodie",
        "shirt",
        "mug",
        "poster",
        "print",
        "bundle",
        "album_cover",
        "logo",
        "signature",
        "other"
      ],
      "default": "hoodie"
    },
    "original_image_url": {
      "type": "string"
    },
    "transparent_png_url": {
      "type": "string"
    },
    "background_removed_status": {
      "type": "string",
      "enum": [
        "uploaded",
        "background_pending",
        "background_removed",
        "needs_cleanup",
        "approved",
        "rejected"
      ],
      "default": "uploaded"
    },
    "edge_cleanup_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "done",
        "not_needed"
      ],
      "default": "not_started"
    },
    "approved_for_public_use": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "product_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
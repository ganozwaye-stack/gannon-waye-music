{
  "name": "RiskAlert",
  "type": "object",
  "properties": {
    "alert_type": {
      "type": "string",
      "enum": [
        "financial",
        "legal",
        "reputation",
        "security",
        "data",
        "brand",
        "system",
        "compliance",
        "opportunity"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ],
      "default": "warning"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_agent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "recommended_action": {
      "type": "string"
    },
    "requires_professional": {
      "type": "boolean",
      "default": false
    },
    "linked_entity": {
      "type": "string"
    },
    "linked_id": {
      "type": "string"
    }
  },
  "required": [
    "alert_type",
    "title",
    "severity"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "EmailSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "how_found": {
      "type": "string",
      "enum": [
        "google",
        "instagram",
        "facebook",
        "tiktok",
        "x_twitter",
        "friend_word_of_mouth",
        "i_know_gannon",
        "other"
      ]
    },
    "consent_updates": {
      "type": "boolean",
      "default": false
    },
    "consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "unsubscribed": {
      "type": "boolean",
      "default": false
    },
    "unsubscribed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "email",
    "name",
    "consent_updates"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
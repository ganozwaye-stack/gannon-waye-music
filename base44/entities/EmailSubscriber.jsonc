{
  "name": "EmailSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Phone number including country code"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth for birthday discounts"
    },
    "how_found": {
      "type": "string",
      "enum": [
        "google",
        "instagram",
        "facebook",
        "tiktok",
        "x_twitter",
        "friend_word_of_mouth",
        "i_know_gannon",
        "other"
      ],
      "description": "How the subscriber found the page"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or context about this subscriber"
    }
  },
  "required": [
    "email",
    "name",
    "phone",
    "how_found"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
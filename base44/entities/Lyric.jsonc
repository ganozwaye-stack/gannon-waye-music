{
  "name": "Lyric",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "release_title": {
      "type": "string",
      "description": "Which release/single this lyric belongs to"
    },
    "lyrics_text": {
      "type": "string",
      "maxLength": 10000
    },
    "inspiration": {
      "type": "string",
      "maxLength": 5000,
      "description": "Story behind the song"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "lyrics_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
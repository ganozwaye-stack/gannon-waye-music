{
  "name": "Lyric",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "release_title": {
      "type": "string",
      "description": "Which release/single this lyric belongs to"
    },
    "lyrics_text": {
      "type": "string",
      "maxLength": 10000
    },
    "inspiration": {
      "type": "string",
      "maxLength": 5000,
      "description": "Story behind the song"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "copyright_year": {
      "type": "string",
      "description": "Copyright year if provided"
    },
    "version_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_review",
        "needs_source",
        "sensitive_review",
        "publish_later",
        "approved"
      ],
      "default": "needs_source"
    },
    "draft_notes": {
      "type": "string",
      "maxLength": 5000,
      "description": "Private notes about draft status, spelling issues, unresolved wording"
    },
    "publishing_status": {
      "type": "string",
      "enum": [
        "not_approved",
        "approved",
        "published"
      ],
      "default": "not_approved"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "source": {
      "type": "string",
      "description": "Where the lyrics came from \u2014 e.g. pasted by Gannon"
    },
    "needs_review": {
      "type": "boolean",
      "default": true
    },
    "contains_explicit_language": {
      "type": "boolean",
      "default": false
    },
    "contains_unresolved_wording": {
      "type": "boolean",
      "default": false
    },
    "contains_sensitive_content": {
      "type": "boolean",
      "default": false
    },
    "publishing_safe": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "lyrics_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
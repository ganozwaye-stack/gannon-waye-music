{
  "name": "Lyric",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "release_title": {
      "type": "string",
      "description": "Legacy display label. It never grants public visibility."
    },
    "release_id": {
      "type": "string",
      "description": "Exact Release record this lyric belongs to. Required for public visibility.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "lyrics_text": {
      "type": "string",
      "maxLength": 10000
    },
    "inspiration": {
      "type": "string",
      "maxLength": 5000,
      "description": "Story behind the song"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Lyric-specific visibility switch. Insufficient without the linked Release approval.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "copyright_year": {
      "type": "string",
      "description": "Copyright year if provided"
    },
    "version_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_review",
        "needs_source",
        "sensitive_review",
        "publish_later",
        "approved"
      ],
      "default": "needs_source"
    },
    "draft_notes": {
      "type": "string",
      "maxLength": 5000,
      "description": "Private notes about draft status, spelling issues, unresolved wording"
    },
    "publishing_status": {
      "type": "string",
      "enum": [
        "not_approved",
        "approved",
        "published"
      ],
      "default": "not_approved"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "source": {
      "type": "string",
      "description": "Where the lyrics came from \u2014 e.g. pasted by Gannon"
    },
    "needs_review": {
      "type": "boolean",
      "default": true
    },
    "contains_explicit_language": {
      "type": "boolean",
      "default": false
    },
    "contains_unresolved_wording": {
      "type": "boolean",
      "default": false
    },
    "contains_sensitive_content": {
      "type": "boolean",
      "default": false
    },
    "publishing_safe": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    },
    "release_publication_approved": {
      "type": "boolean",
      "default": false,
      "description": "Denormalized fail-closed gate set only when Gannon publishes the exact linked Release.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "email": "ganozwaye@gmail.com"
              }
            },
            {
              "user_condition": {
                "email": "gannonwayemusic@gmail.com"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "title",
    "lyrics_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.is_published": true
            },
            {
              "data.publishing_safe": true
            },
            {
              "data.release_publication_approved": true
            },
            {
              "data.publishing_status": "published"
            },
            {
              "data.approval_status": "approved"
            },
            {
              "data.version_status": "approved"
            },
            {
              "data.needs_review": false
            },
            {
              "data.contains_unresolved_wording": false
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "ganozwaye@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "gannonwayemusic@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "ganozwaye@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "gannonwayemusic@gmail.com"
          }
        }
      ]
    }
  }
}
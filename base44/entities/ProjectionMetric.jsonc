{
  "name": "ProjectionMetric",
  "type": "object",
  "properties": {
    "metric_name": {
      "type": "string"
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "streams",
        "visitors",
        "signups",
        "merch_sales",
        "playlists",
        "press_contacts",
        "reels",
        "conversion_rate",
        "revenue",
        "other"
      ],
      "default": "other"
    },
    "current_value": {
      "type": "number",
      "default": 0
    },
    "goal_7day": {
      "type": "number",
      "default": 0
    },
    "goal_30day": {
      "type": "number",
      "default": 0
    },
    "goal_90day": {
      "type": "number",
      "default": 0
    },
    "unit": {
      "type": "string",
      "description": "e.g. count, AUD, %"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "metric_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
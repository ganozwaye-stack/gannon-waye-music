{
  "name": "OrderLock",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Customer email (unique constraint)"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Lock expires after 5 mins"
    },
    "order_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this order lock"
    }
  },
  "required": [
    "customer_email",
    "locked_at",
    "locked_until"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
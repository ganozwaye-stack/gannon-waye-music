{
  "name": "WebsiteOverhaulTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": [
        "public_music_brand",
        "release_pages",
        "lyrics_archive",
        "mums_garden",
        "merch_store",
        "press_pitch",
        "subscribe_fan_list",
        "email_system",
        "social_posting",
        "manychat",
        "metricool",
        "content_studio",
        "google_drive",
        "legal_privacy",
        "performance_mobile",
        "accessibility",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "needs_approval",
        "scheduled",
        "complete",
        "deferred"
      ],
      "default": "not_started"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "related_page": {
      "type": "string"
    },
    "related_song": {
      "type": "string"
    },
    "related_release": {
      "type": "string"
    },
    "related_product": {
      "type": "string"
    },
    "related_link": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "blocker_reason": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "approval_notes": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "DailyDashboardTask",
  "type": "object",
  "properties": {
    "supervisor_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_follow_up_at": {
      "type": "string",
      "format": "date-time"
    },
    "completion_evidence": {
      "type": "string",
      "description": "Source reference proving completion. A task marked done alone is not evidence."
    },
    "completion_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "completion_verified_by": {
      "type": "string",
      "description": "Person or agent who checked the source evidence"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "needs_approval",
        "scheduled",
        "complete",
        "deferred"
      ],
      "default": "not_started"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "related_page": {
      "type": "string"
    },
    "related_song": {
      "type": "string"
    },
    "related_release": {
      "type": "string"
    },
    "related_product": {
      "type": "string"
    },
    "related_link": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "blocker_reason": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "approval_notes": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
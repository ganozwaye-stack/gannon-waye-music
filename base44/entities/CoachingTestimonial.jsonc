{
  "name": "CoachingTestimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Name shown publicly \u2014 e.g. Sarah M. or Anonymous"
    },
    "offer_type": {
      "type": "string"
    },
    "testimonial_text": {
      "type": "string",
      "maxLength": 2000
    },
    "highlight_quote": {
      "type": "string",
      "description": "Short pull quote for hero sections"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "client_name",
    "testimonial_text"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
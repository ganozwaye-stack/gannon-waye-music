{
  "name": "HeroDesignSettings",
  "type": "object",
  "description": "Owner-controlled live design values for the home page hero. Two ways to design: the free-form Canvas Studio saves an elements list (background, text, images, orbit rings, atmosphere, buttons, all freely positioned), while the Fine Sliders tab writes the classic scalar fields. One record flagged is_live holds the public design; other records are the owner's private drafts. The public hero falls back to code defaults when no live record exists.",
  "properties": {
    "is_live": {
      "type": "boolean",
      "default": false,
      "description": "True means this record is the live design the public hero renders. False means it is the owner's private draft, never shown publicly."
    },
    "elements": {
      "type": "array",
      "description": "Canvas Studio design: a list of freely positioned elements. x_pct and y_pct are the element centre as a percentage across and down the hero. Pixel sizes are stored for a 1440px design width and scale with the screen, so the design holds everywhere with no edges showing.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "background",
              "text",
              "image",
              "ring",
              "atmosphere",
              "button"
            ]
          },
          "kind": {
            "type": "string",
            "description": "Sub-type: embers or rays for atmosphere, solid or outline for button"
          },
          "z": {
            "type": "number",
            "default": 0
          },
          "hidden": {
            "type": "boolean",
            "default": false
          },
          "locked": {
            "type": "boolean",
            "default": false
          },
          "x_pct": {
            "type": "number"
          },
          "y_pct": {
            "type": "number"
          },
          "width_pct": {
            "type": "number"
          },
          "rotation_deg": {
            "type": "number",
            "default": 0
          },
          "opacity": {
            "type": "number",
            "default": 1
          },
          "content": {
            "type": "string",
            "description": "Text content or button label"
          },
          "font": {
            "type": "string",
            "description": "Font key: poppins, cormorant, playfair, inter or dancing"
          },
          "font_size": {
            "type": "number",
            "description": "Font size in pixels at a 1440px design width"
          },
          "font_weight": {
            "type": "number"
          },
          "letter_spacing_em": {
            "type": "number"
          },
          "uppercase": {
            "type": "boolean"
          },
          "italic": {
            "type": "boolean"
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ]
          },
          "color": {
            "type": "string",
            "description": "Hex colour for text, button label or ring"
          },
          "image_url": {
            "type": "string",
            "description": "Image source for image and background elements"
          },
          "aspect": {
            "type": "number",
            "description": "Image width divided by height"
          },
          "mask": {
            "type": "string",
            "enum": [
              "none",
              "circle",
              "rounded"
            ]
          },
          "border_color": {
            "type": "string"
          },
          "border_width_px": {
            "type": "number"
          },
          "glow_color": {
            "type": "string"
          },
          "glow_strength": {
            "type": "number",
            "description": "Glow blur radius in pixels at 1440px. 0 is off."
          },
          "shadow_color": {
            "type": "string"
          },
          "shadow_blur": {
            "type": "number"
          },
          "shadow_y": {
            "type": "number"
          },
          "ring_aspect": {
            "type": "number",
            "description": "Orbit ring width divided by height"
          },
          "ring_thickness_px": {
            "type": "number"
          },
          "ring_color": {
            "type": "string"
          },
          "spark_main_size": {
            "type": "number"
          },
          "spark_companion_size": {
            "type": "number"
          },
          "orbit_duration": {
            "type": "number",
            "description": "Seconds for each spark to travel one full lap"
          },
          "density": {
            "type": "number",
            "description": "Ember density multiplier"
          },
          "bg_pos_y": {
            "type": "number",
            "description": "Background framing position, 0 to 100"
          },
          "bg_scan_pct": {
            "type": "number",
            "description": "Background over-scan percentage on every side"
          },
          "bg_blur_px": {
            "type": "number"
          },
          "link": {
            "type": "string",
            "description": "Button destination route"
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    },
    "hero_release_id": {
      "type": "string",
      "default": "",
      "description": "Release the home hero features. Empty string means follow the current single automatically."
    },
    "eyebrow_label": {
      "type": "string",
      "default": "New Single",
      "description": "Small label shown above the hero heading."
    },
    "heart_art_url": {
      "type": "string",
      "default": "",
      "description": "Custom heart artwork image URL. Empty string uses the official built-in Set Free artwork."
    },
    "galaxy_image_url": {
      "type": "string",
      "default": "",
      "description": "Optional galaxy background image URL. Rendered full-bleed with the over-scan so no edge of the image can ever show. Empty string uses the built-in gold glow."
    },
    "heart_pos_y_pct": {
      "type": "number",
      "default": 50,
      "description": "Heart vertical position within the hero, 0 top to 100 bottom."
    },
    "ring_top_pct": {
      "type": "number",
      "default": 12,
      "description": "Orbit ring top edge as a percentage of the heart plate height."
    },
    "ring_left_pct": {
      "type": "number",
      "default": -22,
      "description": "Orbit ring left edge as a percentage of the heart plate width."
    },
    "ring_width_pct": {
      "type": "number",
      "default": 144,
      "description": "Orbit ring width as a percentage of the heart plate width."
    },
    "ring_aspect": {
      "type": "number",
      "default": 3.4,
      "description": "Orbit ring width divided by height. Higher means a flatter ring."
    },
    "ring_rotation_deg": {
      "type": "number",
      "default": -14,
      "description": "Orbit ring tilt in degrees."
    },
    "spark_main_size": {
      "type": "number",
      "default": 8,
      "description": "Main orbit ball diameter in pixels."
    },
    "spark_companion_size": {
      "type": "number",
      "default": 6,
      "description": "Second orbit ball diameter in pixels. 0 hides it."
    },
    "orbit_duration": {
      "type": "number",
      "default": 18,
      "description": "Seconds for each orbit ball to travel one full lap."
    },
    "heart_size_pct": {
      "type": "number",
      "default": 100,
      "description": "Heart plate size as a percentage of the standard width."
    },
    "embers_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show the rising gold embers in the hero."
    },
    "rays_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show the gold light rays behind the heart."
    },
    "galaxy_scan_pct": {
      "type": "number",
      "default": 12,
      "description": "Galaxy plate over-scan percentage on every side, hiding any baked edge of the image."
    },
    "galaxy_pos_y": {
      "type": "number",
      "default": 34,
      "description": "Galaxy vertical framing position, 0 to 100."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
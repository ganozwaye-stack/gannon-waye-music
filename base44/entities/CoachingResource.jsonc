{
  "name": "CoachingResource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "welcome_manual",
        "prep_sheet",
        "values_worksheet",
        "boundary_scripts",
        "reflection_page",
        "goal_tracker",
        "self_worth_checkin",
        "creative_plan",
        "post_session",
        "testimonial_form",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "is_client_only": {
      "type": "boolean",
      "default": true
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "resource_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
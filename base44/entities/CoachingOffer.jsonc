{
  "name": "CoachingOffer",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "who_its_for": {
      "type": "string",
      "maxLength": 2000
    },
    "what_we_cover": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "what_they_leave_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_display": {
      "type": "string",
      "description": "e.g. $150 AUD or Enquire"
    },
    "price_amount": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "format": {
      "type": "string",
      "enum": [
        "zoom",
        "phone",
        "in_person",
        "async"
      ]
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "cta_label": {
      "type": "string",
      "default": "Book a Clarity Session"
    },
    "cta_link": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}